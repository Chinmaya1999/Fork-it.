NODE_ENV=development
PORT=4100
CLIENT_URL=http://localhost:5273
# MongoDB Atlas or local: mongodb://127.0.0.1:27017/projectforge
MONGODB_URI=
# Long random string (>=32 chars). Generate: openssl rand -hex 32
JWT_SECRET=
# Cashfree (preferred when set). Sandbox keys (cfsk_ma_test_…) use the sandbox automatically. Webhook URL: <API>/api/v1/webhooks/cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Razorpay (use TEST keys first). Leave empty in development to use the built-in sandbox gateway (never active in production).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# S3 (private bucket). Empty = local disk storage under ./storage (dev only)
AWS_REGION=
S3_BUCKET=
# SMTP; empty = emails are logged to the API console in dev (and a dev verify link is shown in the dashboard)
# e.g. smtps://USER:PASSWORD@smtp.example.com:465
SMTP_URL=
MAIL_FROM=ProjectForge <no-reply@yourdomain.com>

# Private file storage (dev: local disk, never served statically). Production target: private S3 bucket (pending).
STORAGE_DIR=./storage/private
# Max downloads per file per purchase, and max upload size
DOWNLOAD_LIMIT=10
MAX_UPLOAD_MB=200
# Higher GitHub API rate limits for the importers
GITHUB_TOKEN=
