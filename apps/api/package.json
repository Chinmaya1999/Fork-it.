{
  "name": "@projectforge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "lint": "tsc -p . --noEmit",
    "import-github": "tsx --env-file=../../.env src/scripts/importGithub.ts",
    "seed": "tsx --env-file=../../.env src/scripts/seed.ts",
    "create-admin": "tsx --env-file=../../.env src/scripts/createAdmin.ts",
    "import-projectworlds": "tsx --env-file=../../.env src/scripts/importProjectworlds.ts",
    "attach-zips": "tsx --env-file=../../.env src/scripts/attachZips.ts",
    "reprice": "tsx --env-file=../../.env src/scripts/reprice.ts",
    "import-enggroom": "tsx --env-file=../../.env src/scripts/importEnggroom.ts"
  },
  "dependencies": {
    "@projectforge/shared": "*",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.0.3",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.15.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
